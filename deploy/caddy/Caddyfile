{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8100
	}

	handle {
		reverse_proxy web:3000
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

http://{$PUBLIC_IP} {
	redir https://{$DOMAIN}{uri} permanent
}

# Other apps on this VM (e.g. whisper_bro at protocol-agi.xyz) drop their own site blocks into the caddy_config
# volume, so they share ports 80/443 without changing coframe. An empty glob is valid; keep this line.
import /config/sites.d/*.caddy
