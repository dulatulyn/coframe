<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="sid-defs" targetNamespace="http://www.signavio.com">
   <process id="sid-process" isExecutable="false">
      <startEvent id="sid-start" name="Start">
         <outgoing>sid-flow-1</outgoing>
      </startEvent>
      <parallelGateway id="sid-split" gatewayDirection="Diverging">
         <incoming>sid-flow-1</incoming>
         <outgoing>sid-flow-2</outgoing>
         <outgoing>sid-flow-3</outgoing>
      </parallelGateway>
      <manualTask id="sid-manual" name="Sign">
         <incoming>sid-flow-2</incoming>
      </manualTask>
      <receiveTask id="sid-receive" name="Wait for fax" instantiate="false">
         <incoming>sid-flow-3</incoming>
      </receiveTask>
      <sequenceFlow id="sid-flow-1" sourceRef="sid-start" targetRef="sid-split"/>
      <sequenceFlow id="sid-flow-2" sourceRef="sid-split" targetRef="sid-manual"/>
      <sequenceFlow id="sid-flow-3" sourceRef="sid-split" targetRef="sid-receive"/>
   </process>
   <bpmndi:BPMNDiagram id="sid-diagram">
      <bpmndi:BPMNPlane bpmnElement="sid-process" id="sid-plane">
         <bpmndi:BPMNShape bpmnElement="sid-start" id="sid-start_gui">
            <omgdc:Bounds height="30.0" width="30.0" x="90.0" y="120.0"/>
         </bpmndi:BPMNShape>
         <bpmndi:BPMNShape bpmnElement="sid-split" id="sid-split_gui">
            <omgdc:Bounds height="40.0" width="40.0" x="165.0" y="115.0"/>
         </bpmndi:BPMNShape>
         <bpmndi:BPMNShape bpmnElement="sid-manual" id="sid-manual_gui">
            <omgdc:Bounds height="80.0" width="100.0" x="250.0" y="40.0"/>
         </bpmndi:BPMNShape>
         <bpmndi:BPMNShape bpmnElement="sid-receive" id="sid-receive_gui">
            <omgdc:Bounds height="80.0" width="100.0" x="250.0" y="160.0"/>
         </bpmndi:BPMNShape>
         <bpmndi:BPMNEdge bpmnElement="sid-flow-1" id="sid-flow-1_gui">
            <omgdi:waypoint x="120.0" y="135.0"/>
            <omgdi:waypoint x="165.0" y="135.0"/>
         </bpmndi:BPMNEdge>
         <bpmndi:BPMNEdge bpmnElement="sid-flow-2" id="sid-flow-2_gui">
            <omgdi:waypoint x="185.5" y="115.0"/>
            <omgdi:waypoint x="185.5" y="80.0"/>
            <omgdi:waypoint x="250.0" y="80.0"/>
         </bpmndi:BPMNEdge>
         <bpmndi:BPMNEdge bpmnElement="sid-flow-3" id="sid-flow-3_gui">
            <omgdi:waypoint x="185.5" y="155.0"/>
            <omgdi:waypoint x="185.5" y="200.0"/>
            <omgdi:waypoint x="250.0" y="200.0"/>
         </bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
   </bpmndi:BPMNDiagram>
</definitions>
