<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_mock" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_mock">
    <bpmn:participant id="Participant_shop" name="Online shop" processRef="Process_o2c" />
    <bpmn:participant id="Participant_customer" name="Customer" />
    <bpmn:messageFlow id="Msg_order" name="Order" sourceRef="Participant_customer" targetRef="Start_order" />
    <bpmn:messageFlow id="Msg_invoice" name="Invoice" sourceRef="Task_invoice" targetRef="Participant_customer" />
    <bpmn:messageFlow id="Msg_payment" name="Payment" sourceRef="Participant_customer" targetRef="Task_payment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_o2c" isExecutable="false">
    <bpmn:laneSet id="LaneSet_o2c">
      <bpmn:lane id="Lane_sales" name="Sales">
        <bpmn:flowNodeRef>Start_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_finance" name="Finance">
        <bpmn:flowNodeRef>Task_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_due</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_overdue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_order" name="Order received">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_order" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_check" name="Check order">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:property id="Property_crm" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_crm">
        <bpmn:sourceRef>Store_crm</bpmn:sourceRef>
        <bpmn:targetRef>Property_crm</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ok" name="Order OK?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_yes</bpmn:outgoing>
      <bpmn:outgoing>F_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_rejected" name="Order rejected">
      <bpmn:incoming>F_no</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_rejected" />
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_invoice" name="Send invoice">
      <bpmn:incoming>F_yes</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_payment" name="Receive payment">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Timer_due" name="14 days" attachedToRef="Task_payment">
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_due">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_paid" name="Order paid">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_overdue" name="Payment overdue">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EscalationEventDefinition_overdue" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_order" targetRef="Task_check" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_check" targetRef="Gateway_ok" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="Gateway_ok" targetRef="Task_invoice" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="Gateway_ok" targetRef="End_rejected" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_invoice" targetRef="Task_payment" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_payment" targetRef="End_paid" />
    <bpmn:sequenceFlow id="F5" sourceRef="Timer_due" targetRef="End_overdue" />
    <bpmn:dataStoreReference id="Store_crm" name="CRM" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mock">
    <bpmndi:BPMNPlane id="BPMNPlane_mock" bpmnElement="Collaboration_mock">
      <bpmndi:BPMNShape id="Participant_shop_di" bpmnElement="Participant_shop" isHorizontal="true">
        <dc:Bounds x="160" y="120" width="860" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_sales_di" bpmnElement="Lane_sales" isHorizontal="true">
        <dc:Bounds x="190" y="120" width="830" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_finance_di" bpmnElement="Lane_finance" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="830" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_order_di" bpmnElement="Start_order">
        <dc:Bounds x="232" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="213" y="180" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_check_di" bpmnElement="Task_check">
        <dc:Bounds x="320" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ok_di" bpmnElement="Gateway_ok" isMarkerVisible="true">
        <dc:Bounds x="475" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="473" y="171" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_rejected_di" bpmnElement="End_rejected">
        <dc:Bounds x="612" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="594" y="245" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_invoice_di" bpmnElement="Task_invoice">
        <dc:Bounds x="560" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_payment_di" bpmnElement="Task_payment">
        <dc:Bounds x="720" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_paid_di" bpmnElement="End_paid">
        <dc:Bounds x="882" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="873" y="455" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_overdue_di" bpmnElement="End_overdue">
        <dc:Bounds x="882" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="493" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_due_di" bpmnElement="Timer_due">
        <dc:Bounds x="782" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="781" y="508" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Store_crm_di" bpmnElement="Store_crm">
        <dc:Bounds x="345" y="40" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="403" y="58" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="268" y="220" />
        <di:waypoint x="320" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="420" y="220" />
        <di:waypoint x="475" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_no_di" bpmnElement="F_no">
        <di:waypoint x="525" y="220" />
        <di:waypoint x="612" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="562" y="202" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_yes_di" bpmnElement="F_yes">
        <di:waypoint x="500" y="245" />
        <di:waypoint x="500" y="430" />
        <di:waypoint x="560" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="506" y="330" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="660" y="430" />
        <di:waypoint x="720" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="820" y="430" />
        <di:waypoint x="882" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="800" y="488" />
        <di:waypoint x="800" y="500" />
        <di:waypoint x="882" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataInputAssociation_crm_di" bpmnElement="DataInputAssociation_crm">
        <di:waypoint x="370" y="90" />
        <di:waypoint x="370" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_customer_di" bpmnElement="Participant_customer" isHorizontal="true">
        <dc:Bounds x="160" y="600" width="860" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Msg_order_di" bpmnElement="Msg_order">
        <di:waypoint x="250" y="600" />
        <di:waypoint x="250" y="238" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="256" y="470" width="30" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_invoice_di" bpmnElement="Msg_invoice">
        <di:waypoint x="610" y="470" />
        <di:waypoint x="610" y="600" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="616" y="548" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_payment_di" bpmnElement="Msg_payment">
        <di:waypoint x="740" y="600" />
        <di:waypoint x="740" y="470" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="746" y="548" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
